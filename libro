class Libro:
    def __init__(self, titulo, autor, genero, paginas):
        self._titulo = titulo
        self._autor = autor
        self._genero = genero
        self._paginas = paginas
    def get_titulo(self):
        return self._titulo
    def set_titulo(self, t):
        self._titulo = t
    def get_autor(self):
        return self._autor
    def set_autor(self, a):
        self._autor = a
    def get_genero(self):
        return self._genero
    def set_genero(self, g):
        self._genero = g
    def get_paginas(self):
        return self._paginas
    def set_paginas(self, p):
        if p > 0:
            self._paginas = p
    def es_ficcion(self):
        return self._genero.lower() == "ficcion"
